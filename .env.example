# =========================================================================
# Sarkin Mota HQ — Environment Credentials Template
# Copy this file to .env and configure your environment settings.
# =========================================================================

APP_NAME="Sarkin Mota HQ"
APP_ENV=development
APP_DEBUG=true
APP_URL="http://localhost:8080/SarkinMota"
APP_KEY="base64:YourSecretKeyHere"

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sarkinmotahq_db
DB_USERNAME=root
DB_PASSWORD=

# Payment Gateway Credentials
PAYSTACK_SECRET_KEY=sk_test_your_paystack_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_your_flutterwave_key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_your_flutterwave_key
PAYMENT_CURRENCY=NGN

# Enterprise REST API Credentials
API_SECRET_KEY=YourApiSecretKeyHere

# Corporate Email & SMTP Credentials
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contact@sarkinmotahq.com
MAIL_FROM_NAME="Sarkin Mota HQ"
